generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TxType {
  in
  out
  adjust
  transfer
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  label       String
  createdAt   DateTime         @default(now())
  users       User[]
  permissions RolePermission[]
}

model User {
  id           Int                @id @default(autoincrement())
  name         String
  email        String             @unique
  passwordHash String
  roleId       Int
  role         Role               @relation(fields: [roleId], references: [id])
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  deletedAt    DateTime?
  transactions StockTransaction[]

  categoryCreated    Category[]        @relation("CategoryCreatedBy")
  categoryUpdated    Category[]        @relation("CategoryUpdatedBy")
  productTypeCreated ProductTypeItem[] @relation("ProductTypeCreatedBy")
  productTypeUpdated ProductTypeItem[] @relation("ProductTypeUpdatedBy")
  unitCreated        Unit[]            @relation("UnitCreatedBy")
  unitUpdated        Unit[]            @relation("UnitUpdatedBy")
  warehouseCreated   Warehouse[]       @relation("WarehouseCreatedBy")
  warehouseUpdated   Warehouse[]       @relation("WarehouseUpdatedBy")
  binCreated         BinLocation[]     @relation("BinCreatedBy")
  binUpdated         BinLocation[]     @relation("BinUpdatedBy")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  products    Product[]
}

model Product {
  id           Int                @id @default(autoincrement())
  name         String
  sku          String             @unique
  barcode      String?
  image        String?
  categoryId   Int?
  category     Category?          @relation(fields: [categoryId], references: [id])
  productType  String             @default("raw")
  unit         String
  costPrice    Decimal            @db.Decimal(12, 2)
  salePrice    Decimal            @db.Decimal(12, 2)
  minStock     Int                @default(0)
  currentStock Int                @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  transactions StockTransaction[]
  stocks       ProductStock[]
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  menuKey   String
  canView   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([roleId, menuKey])
}

model ProductTypeItem {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  label       String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("ProductTypeCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("ProductTypeUpdatedBy", fields: [updatedById], references: [id])
}

model Unit {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("UnitCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("UnitUpdatedBy", fields: [updatedById], references: [id])
}

model Warehouse {
  id               Int                @id @default(autoincrement())
  code             String             @unique
  name             String
  shortName        String?
  address          String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  createdById      Int?
  updatedById      Int?
  createdBy        User?              @relation("WarehouseCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?              @relation("WarehouseUpdatedBy", fields: [updatedById], references: [id])
  bins             BinLocation[]
  stocks           ProductStock[]
  fromTransactions StockTransaction[] @relation("TxFromWarehouse")
  toTransactions   StockTransaction[] @relation("TxToWarehouse")
}

model BinLocation {
  id               Int                @id @default(autoincrement())
  warehouseId      Int
  warehouse        Warehouse          @relation(fields: [warehouseId], references: [id])
  code             String
  name             String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  createdById      Int?
  updatedById      Int?
  createdBy        User?              @relation("BinCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?              @relation("BinUpdatedBy", fields: [updatedById], references: [id])
  fromTransactions StockTransaction[] @relation("TxFromBin")
  toTransactions   StockTransaction[] @relation("TxToBin")

  @@unique([warehouseId, code])
}

model ProductStock {
  productId   Int
  warehouseId Int
  quantity    Int       @default(0)
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([productId, warehouseId])
}

model StockTransaction {
  id            Int          @id @default(autoincrement())
  product       Product      @relation(fields: [productId], references: [id])
  productId     Int
  type          TxType
  quantity      Int
  fromLocation  String?
  toLocation    String?
  warehouseId   Int?
  toWarehouseId Int?
  binId         Int?
  toBinId       Int?
  warehouse     Warehouse?   @relation("TxFromWarehouse", fields: [warehouseId], references: [id])
  toWarehouse   Warehouse?   @relation("TxToWarehouse", fields: [toWarehouseId], references: [id])
  bin           BinLocation? @relation("TxFromBin", fields: [binId], references: [id])
  tobin         BinLocation? @relation("TxToBin", fields: [toBinId], references: [id])
  reason        String?
  note          String?
  createdBy     User         @relation(fields: [userId], references: [id])
  userId        Int
  createdAt     DateTime     @default(now())
}
